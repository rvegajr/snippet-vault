{
  "name": "snippet-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server/index.js",
    "build": "rm -rf dist && npm run build:server && npm run build:client",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server/index.js --packages=external",
    "build:client": "esbuild src/client/main.ts --bundle --outfile=dist/client/main.js --target=es2020 && cp src/client/index.html dist/client/index.html && cp src/client/styles.css dist/client/styles.css",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^13.0.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
